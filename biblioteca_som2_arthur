-- Exercicio 17: INNER JOIN - ID do emprestimo, usuario, livro, data e status
SELECT 
    E.id_emprestimo,
    U.nome AS nome_usuario,
    L.titulo AS titulo_livro,
    E.data_emprestimo,
    E.status_emprestimo
FROM EMPRESTIMO E
INNER JOIN USUARIO U ON E.id_usuario = U.id_usuario
INNER JOIN LIVRO L ON E.id_livro = L.id_livro;

