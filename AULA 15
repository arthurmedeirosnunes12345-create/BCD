DELIMITER $$

CREATE FUNCTION CLASSIFICAR_FIDELIDADES
(
    P_PONTOS INT
)
RETURNS VARCHAR(20)
DETERMINISTIC
BEGIN
    DECLARE V_NIVEL VARCHAR(20);

    IF P_PONTOS >= 1000 THEN
        SET V_NIVEL = 'Ouro';
    ELSEIF P_PONTOS >= 500 THEN
        SET V_NIVEL = 'Prata';
    ELSE
        SET V_NIVEL = 'Bronze';
    END IF;

    RETURN V_NIVEL;
END$$

