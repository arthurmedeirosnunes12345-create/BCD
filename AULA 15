-- EXEMPLO 2:  Total de Item
DELIMITER $$
CREATE FUNCTION calcular_total_item
(p_preco DECIMAL (10,2) , p_quantidade INT)
RETURNS DECIMAL(10,2)
DETERMINISTIC 
BEGIN
    RETURN p_preco * p_quantidade;
END $$
DELIMITER;

-- OBS: Agora função pode ser usada como se fosse uma função nativa
-- Apresentarr o resultado da FUNCTION

