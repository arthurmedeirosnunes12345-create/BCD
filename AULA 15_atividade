-- 1. Function calcular_total_item
-- Calcula o valor total multiplicando quantidade pelo preço unitário
DELIMITER $$
CREATE FUNCTION calcular_total_item(p_qtd INT, p_preco DECIMAL(10,2))
RETURNS DECIMAL(10,2)
DETERMINISTIC
BEGIN
    RETURN p_qtd * p_preco;
END $$
DELIMITER ;

-- 2. Function classificar_fidelidade
-- Classifica o cliente com base no valor total já gasto

DELIMITER $$
CREATE FUNCTION classificar_fidelidade(p_total_gasto DECIMAL(10,2))
RETURNS VARCHAR(20)
DETERMINISTIC
BEGIN
    IF p_total_gasto >= 5000 THEN
        RETURN 'OURO';
    ELSEIF p_total_gasto >= 1000 THEN
        RETURN 'PRATA';
    ELSE
        RETURN 'BRONZE';
    END IF;
END $$
DELIMITER ;


-- 3. Function calcular_desconto
-- Calcula o valor em reais do desconto dado um percentual

DELIMITER $$
CREATE FUNCTION calcular_desconto(p_valor DECIMAL(10,2), p_percentual DECIMAL(5,2))
RETURNS DECIMAL(10,2)
DETERMINISTIC
BEGIN
    RETURN p_valor * (p_percentual / 100);
END $$
DELIMITER ;


-- 4. Function situacao_estoque
-- Retorna o status visual do saldo de um produto

DELIMITER $$
CREATE FUNCTION situacao_estoque(p_qtd INT)
RETURNS VARCHAR(20)
DETERMINISTIC
BEGIN
    IF p_qtd <= 0 THEN
        RETURN 'ESGOTADO';
    ELSEIF p_qtd <= 10 THEN
        RETURN 'ESTOQUE BAIXO';
    ELSE
        RETURN 'NORMAL';
    END IF;
END $$
DELIMITER ;


